# ============================================================
# Mission Control - Environment Configuration
# ============================================================
# Copy this to .env and fill in your values
# ============================================================

# --- LLM Authentication (Claude Code subscription) ---
# Requires a Claude Pro/Max subscription.
# Run: claude auth login
# Then copy the token, or run: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# --- Database ---
# Option A: PostgreSQL (recommended)
POSTGRES_USER=missionctl
POSTGRES_PASSWORD=missionctl
POSTGRES_DB=missioncontrol

# Option B: SQLite (zero-config local dev)
# USE_SQLITE=true
# SQLITE_PATH=data/mission_control.db

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
# Required: the bot ignores everyone not listed here. Message the bot once and it
# replies with your ID, or ask @userinfobot.
TELEGRAM_ALLOWED_USERS=  # comma-separated Telegram user IDs
TELEGRAM_NOTIFICATION_CHAT_ID=  # optional, falls back to first allowed user
NOTIFICATION_TIMEZONE=UTC  # morning briefing, reminders and agent cron schedules, e.g. "Asia/Kolkata"

# --- GitHub (optional): /dev turns coding work into issues for Claude Code ---
# Token needs Issues read/write on your repos. Install the Claude GitHub app
# (https://github.com/apps/claude) on those repos so @claude mentions get picked up.
GITHUB_TOKEN=
GITHUB_MENTION_CLAUDE=true

# --- Publishing (optional): post approved drafts to X and LinkedIn with one tap ---
# X: create an app at developer.x.com with Read and write permissions, then generate
# the access token and secret for your own account (OAuth 1.0a).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# LinkedIn: a member access token with the w_member_social scope (valid 60 days)
# and your member URN, e.g. urn:li:person:AbC123 (from GET /v2/userinfo "sub").
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
# LINKEDIN_API_VERSION=202609

# --- Dashboard login ---
# Required unless you only ever open the dashboard on this machine.
DASHBOARD_PASSWORD=
# Optional: lets scripts call the API with "Authorization: Bearer <token>"
API_TOKEN=

# --- Public address ---
# Your domain (e.g. mc.example.com) to serve over HTTPS with an automatic
# certificate; leave as :80 for plain http://localhost
SITE_ADDRESS=:80

# --- Backups (nightly, in the backend-data volume) ---
BACKUP_KEEP=14
BACKUP_HOUR=3

# --- Service Ports ---
HTTP_PORT=80
HTTPS_PORT=443
API_PORT=8000   # bound to localhost only
DB_PORT=5432    # bound to localhost only

# --- Agent Defaults ---
DEFAULT_MODEL=claude-haiku-4-5
SMART_MODEL=claude-sonnet-4-6
CHAT_MODEL=claude-sonnet-4-6
MAX_AGENT_BUDGET_USD=0.50

# --- Voice (optional) ---
# OPENAI_API_KEY=  # for Whisper voice transcription

# --- Identity ---
BOT_NAME=MC
IDENTITY_FILE=workspace/identity.md
